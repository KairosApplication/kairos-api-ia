# Example only. Prefer scripts/run.ps1 -EnvFile <external credentials file>.
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
# Required if MONGODB_URI does not include a database. Set the actual verified name.
MONGODB_DATABASE=
API_PORT=8081
APP_MONGODB_VERIFY_ON_STARTUP=true

API_ACCESS_TOKEN=
APP_MONGODB_WRITES_ENABLED=false
